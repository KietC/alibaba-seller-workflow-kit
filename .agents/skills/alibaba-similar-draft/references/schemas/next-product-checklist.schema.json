{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/next-product-checklist.schema.json",
  "title": "SellerKit Alibaba next product high-confidence checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_kind",
    "target_model",
    "template_product_id",
    "mode",
    "unresolved_p0",
    "policy",
    "source_freeze",
    "dynamic_schema",
    "approvals",
    "action_plan",
    "probe",
    "endpoint_guard",
    "baseline",
    "execution",
    "save",
    "post_save",
    "steps"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableArtifact": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/artifact"}
      ]
    },
    "countSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online", "pending", "draft", "ids_sha256"],
      "properties": {
        "online": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "draft": {"type": "integer", "minimum": 0},
        "ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "run_kind": {"const": "CREATE_SIMILAR_DRAFT"},
    "target_model": {"type": "string", "minLength": 2, "maxLength": 128},
    "template_product_id": {"type": "string", "pattern": "^[0-9]{8,32}$"},
    "mode": {"const": "save_draft"},
    "unresolved_p0": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "target_disposition",
        "template_disposition",
        "target_publish_draft",
        "target_external_write_enabled",
        "target_allow_rag",
        "template_allowed_as_ui_skeleton"
      ],
      "properties": {
        "binding": {"$ref": "#/$defs/artifact"},
        "target_disposition": {"type": "string"},
        "template_disposition": {"type": "string"},
        "target_publish_draft": {"type": "boolean"},
        "target_external_write_enabled": {"type": "boolean"},
        "target_allow_rag": {"type": "boolean"},
        "template_allowed_as_ui_skeleton": {"type": "boolean"}
      }
    },
    "source_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "all_inputs_hashed", "fact_conflicts_resolved"],
      "properties": {
        "manifest": {"$ref": "#/$defs/artifact"},
        "all_inputs_hashed": {"type": "boolean"},
        "fact_conflicts_resolved": {"type": "boolean"}
      }
    },
    "dynamic_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "category_id",
        "captured_at_utc",
        "max_age_minutes",
        "required_field_ids",
        "current_for_account_and_category"
      ],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "category_id": {"type": "string", "pattern": "^[0-9]+$"},
        "captured_at_utc": {"type": "string", "format": "date-time"},
        "max_age_minutes": {"const": 15},
        "required_field_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "current_for_account_and_category": {"type": "boolean"}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "assets", "commercial", "content", "write"],
      "properties": {
        "source": {"$ref": "#/$defs/artifact"},
        "assets": {"$ref": "#/$defs/artifact"},
        "commercial": {"$ref": "#/$defs/artifact"},
        "content": {"$ref": "#/$defs/artifact"},
        "write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "status", "scope", "max_save_attempts", "expires_at_utc"],
          "properties": {
            "artifact": {"$ref": "#/$defs/artifact"},
            "status": {"const": "APPROVED"},
            "scope": {"const": "SAVE_ONE_DRAFT_VISIBLE_UI_ONLY"},
            "max_save_attempts": {"const": 1},
            "expires_at_utc": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "action_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "run_id", "target_model", "template_product_id", "approved_field_ids", "save_draft_operations", "final_write_operations"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "run_id": {"type": "string"},
        "target_model": {"type": "string"},
        "template_product_id": {"type": "string"},
        "approved_field_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "save_draft_operations": {"const": 1},
        "final_write_operations": {"const": 0}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "verification", "status", "origin", "path", "template_product_id", "request_count", "write_request_count", "final_write_request_count", "login_ok", "captcha_absent", "page_fingerprint_sha256", "performed_after_guard_install"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "verification": {"$ref": "#/$defs/artifact"},
        "status": {"const": "PASS_ZERO_WRITE"},
        "origin": {"const": "https://post.alibaba.com"},
        "path": {"const": "/product/publish.htm"},
        "template_product_id": {"type": "string"},
        "request_count": {"type": "integer", "minimum": 1},
        "write_request_count": {"const": 0},
        "final_write_request_count": {"const": 0},
        "login_ok": {"const": true},
        "captcha_absent": {"const": true},
        "page_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "performed_after_guard_install": {"const": true}
      }
    },
    "endpoint_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "unknown_writes_default", "draft_write_mode", "final_write_enabled", "final_write_double_blocked", "bound_action_plan_sha256", "bound_probe_sha256"],
      "properties": {
        "policy": {"$ref": "#/$defs/artifact"},
        "unknown_writes_default": {"const": "BLOCK"},
        "draft_write_mode": {"const": "VISIBLE_UI_SINGLE_SAVE_ONLY"},
        "final_write_enabled": {"const": false},
        "final_write_double_blocked": {"const": true},
        "bound_action_plan_sha256": {"$ref": "#/$defs/sha256"},
        "bound_probe_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "counts", "target_duplicate_count", "captured_after_probe"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "counts": {"$ref": "#/$defs/countSnapshot"},
        "target_duplicate_count": {"const": 0},
        "captured_after_probe": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill_receipt", "approved_field_ids", "readback_field_ids", "template_residue_count", "non_target_diff_count", "all_required_fields_valid", "asset_hashes_match"],
      "properties": {
        "fill_receipt": {"$ref": "#/$defs/nullableArtifact"},
        "approved_field_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "readback_field_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "template_residue_count": {"type": "integer", "minimum": 0},
        "non_target_diff_count": {"type": "integer", "minimum": 0},
        "all_required_fields_valid": {"type": "boolean"},
        "asset_hashes_match": {"type": "boolean"}
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_count", "ui_receipt", "network_receipt", "business_success", "business_error_count", "draft_id", "final_write_request_count"],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "ui_receipt": {"$ref": "#/$defs/nullableArtifact"},
        "network_receipt": {"$ref": "#/$defs/nullableArtifact"},
        "business_success": {"type": "boolean"},
        "business_error_count": {"type": "integer", "minimum": 0},
        "draft_id": {"type": ["string", "null"], "pattern": "^[0-9]{8,32}$"},
        "final_write_request_count": {"const": 0}
      }
    },
    "post_save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reopen_receipt", "after_artifact", "after_counts", "persistence_match", "new_target_draft_count", "online_id_set_unchanged", "pending_id_set_unchanged", "stopped_before_final_submit"],
      "properties": {
        "reopen_receipt": {"$ref": "#/$defs/nullableArtifact"},
        "after_artifact": {"$ref": "#/$defs/nullableArtifact"},
        "after_counts": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/countSnapshot"}]},
        "persistence_match": {"type": "boolean"},
        "new_target_draft_count": {"type": "integer", "minimum": 0},
        "online_id_set_unchanged": {"type": "boolean"},
        "pending_id_set_unchanged": {"type": "boolean"},
        "stopped_before_final_submit": {"type": "boolean"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^P(?:0[0-9]|1[0-9]|2[0-7])$"},
          "status": {"enum": ["NOT_STARTED", "PASS", "BLOCKED", "NOT_APPLICABLE"]},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
            "then": {"properties": {"evidence": {"minItems": 1}}}
          }
        ]
      }
    }
  }
}
