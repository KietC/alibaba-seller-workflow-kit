{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/alibaba-similar-draft/approved-source-manifest.schema.json",
  "title": "Alibaba Similar Draft Approved Source Manifest",
  "description": "Fail-closed manifest for sources explicitly approved for one guarded similar-product draft. Raw archive disposition records are not valid substitutes for this manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "run_id",
    "target_model",
    "generated_at",
    "approval",
    "bindings",
    "dynamic_schema",
    "source_count",
    "rejected_source_count",
    "sources",
    "write_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "alibaba.approved-source-manifest.v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyId"
    },
    "target_model": {
      "$ref": "#/$defs/targetModel"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "dynamic_schema": {
      "$ref": "#/$defs/dynamicSchema"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1
    },
    "rejected_source_count": {
      "const": 0
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "approved_field_values": {
      "$ref": "#/$defs/approvedFieldValues"
    },
    "draft_field_policy": {
      "$ref": "#/$defs/draftFieldPolicy"
    },
    "write_policy": {
      "$ref": "#/$defs/writePolicy"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nonEmptyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "targetModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\\\/\\r\\n]+$"
    },
    "approvedFieldValues": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "value_sha256",
          "source_id",
          "decision_id"
        ],
        "properties": {
          "value": {},
          "value_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "source_id": {
            "$ref": "#/$defs/nonEmptyId"
          },
          "decision_id": {
            "$ref": "#/$defs/nonEmptyId"
          },
          "write_target": {
            "$ref": "#/$defs/writeTarget"
          }
        }
      }
    },
    "dynamicSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "capture_id",
        "decision_id",
        "category_id",
        "product_type",
        "captured_at",
        "expires_at",
        "capture",
        "raw_payload",
        "normalized_official_schema",
        "official_field_paths_sha256",
        "official_rule_graph_sha256",
        "field_ids",
        "required_field_ids",
        "field_set_sha256",
        "required_field_set_sha256",
        "source_kind",
        "source_endpoint",
        "source_operation",
        "provenance_status",
        "final_write_enabled"
      ],
      "properties": {
        "status": {"const": "CURRENT_SCHEMA_BOUND"},
        "capture_id": {"$ref": "#/$defs/nonEmptyId"},
        "decision_id": {"$ref": "#/$defs/nonEmptyId"},
        "category_id": {"$ref": "#/$defs/nonEmptyId"},
        "product_type": {"$ref": "#/$defs/nonEmptyId"},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "capture": {"$ref": "#/$defs/fileBinding"},
        "raw_payload": {"$ref": "#/$defs/fileBinding"},
        "normalized_official_schema": {"$ref": "#/$defs/fileBinding"},
        "official_field_paths_sha256": {"$ref": "#/$defs/sha256"},
        "official_rule_graph_sha256": {"$ref": "#/$defs/sha256"},
        "field_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        },
        "required_field_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        },
        "field_set_sha256": {"$ref": "#/$defs/sha256"},
        "required_field_set_sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {"const": "OFFICIAL_SCHEMA_GET"},
        "source_endpoint": {"const": "https://eco.taobao.com/router/rest"},
        "source_operation": {"const": "alibaba.icbu.product.schema.get"},
        "provenance_status": {"const": "OFFICIAL_XML_SAME_SOURCE_REPARSED"},
        "final_write_enabled": {"const": false}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n]+$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fieldName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "writeTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "FIELD_REGISTRY"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "approved_property_name"],
          "properties": {
            "kind": {"const": "CATEGORY_PROPERTY"},
            "approved_property_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "[^\\s]"
            }
          }
        },
        {
          "$ref": "#/$defs/localizedTarget"
        }
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
    },
    "localizedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "logical_name", "locale", "live_language_label", "direction",
        "expected_sha256", "max_length_rule_hash", "max_length_rule", "identity_sha256"
      ],
      "properties": {
        "kind": {"const": "LOCALIZED_FIELD"},
        "logical_name": {"$ref": "#/$defs/fieldName"},
        "locale": {"$ref": "#/$defs/locale"},
        "live_language_label": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "[^\\s]"},
        "direction": {"enum": ["LTR", "RTL"]},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "max_length_rule_hash": {"$ref": "#/$defs/sha256"},
        "max_length_rule": {"$ref": "#/$defs/maxLengthRule"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "maxLengthRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "captured_at", "expires_at", "locale",
        "live_language_label_sha256", "page_fingerprint_sha256",
        "live_control_evidence_sha256", "maximum", "unit", "observed_count",
        "candidate_value_sha256", "current_session_only",
        "require_post_write_counter_readback", "final_write_enabled"
      ],
      "properties": {
        "source": {"const": "CURRENT_VISIBLE_UI"},
        "captured_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "locale": {"$ref": "#/$defs/locale"},
        "live_language_label_sha256": {"$ref": "#/$defs/sha256"},
        "page_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "live_control_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "maximum": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "unit": {"enum": ["UNICODE_CODE_POINTS", "UTF8_BYTES", "PLATFORM_COUNTER"]},
        "observed_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "candidate_value_sha256": {"$ref": "#/$defs/sha256"},
        "current_session_only": {"const": true},
        "require_post_write_counter_readback": {"const": true},
        "final_write_enabled": {"const": false}
      }
    },
    "draftFieldPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "explicit_user_instruction_sha256",
        "blocked_fields",
        "save_incomplete_draft_allowed",
        "publish_ready_claim_allowed",
        "final_write_enabled"
      ],
      "properties": {
        "mode": {
          "const": "PARTIAL_DRAFT_FILL_APPROVED_ONLY"
        },
        "explicit_user_instruction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "blocked_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        },
        "save_incomplete_draft_allowed": {
          "const": true
        },
        "publish_ready_claim_allowed": {
          "const": false
        },
        "final_write_enabled": {
          "const": false
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "explicit",
        "scope",
        "origin",
        "decision_id",
        "approved_by",
        "approved_at",
        "approval_package_sha256"
      ],
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "explicit": {
          "const": true
        },
        "scope": {
          "const": "SIMILAR_DRAFT_SOURCE_USE_ONLY"
        },
        "origin": {
          "const": "HUMAN_REVIEWED_CANDIDATE_PACKAGE"
        },
        "decision_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "approved_by": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "notes_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_package_sha256",
        "source_inventory_sha256",
        "field_registry_sha256",
        "schema_bundle_sha256",
        "target_model_normalized"
      ],
      "properties": {
        "candidate_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "field_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_model_normalized": {
          "$ref": "#/$defs/targetModel"
        },
        "template_product_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_role",
        "record_disposition",
        "path",
        "media_type",
        "bytes",
        "sha256",
        "decision_id",
        "approved_fields",
        "usage_policy"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "source_role": {
          "enum": [
            "PRODUCT_FACT",
            "COMMERCIAL_DECISION",
            "COMPANY_POLICY",
            "APPROVED_ASSET_ORIGIN"
          ]
        },
        "record_disposition": {
          "const": "APPROVED_INTERNAL_SOURCE"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\r\\n]+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_id": {
          "$ref": "#/$defs/nonEmptyId"
        },
        "approved_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        },
        "usage_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_rag",
            "fact_extraction",
            "publish_draft",
            "auto_listing",
            "external_disclosure",
            "final_write"
          ],
          "properties": {
            "allow_rag": {
              "const": true
            },
            "fact_extraction": {
              "const": true
            },
            "publish_draft": {
              "const": true
            },
            "auto_listing": {
              "const": false
            },
            "external_disclosure": {
              "const": false
            },
            "final_write": {
              "const": false
            }
          }
        }
      }
    },
    "writePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_external_write_enabled",
        "draft_save_requires_separate_approval",
        "final_write_enabled",
        "raw_disposition_may_grant_approval"
      ],
      "properties": {
        "candidate_external_write_enabled": {
          "const": false
        },
        "draft_save_requires_separate_approval": {
          "const": true
        },
        "final_write_enabled": {
          "const": false
        },
        "raw_disposition_may_grant_approval": {
          "const": false
        }
      }
    }
  }
}
