{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/alibaba-similar-draft/localized-counter-expectation.schema.json",
  "title": "Localized counter expectation bound to one guarded run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "expectation_id", "run_id", "target_model", "template_product_id",
    "browser_session_sha256", "page_fingerprint_sha256", "fields", "field_identities_sha256",
    "exact_locale_set_required", "write_authority", "final_write_enabled"
  ],
  "properties": {
    "schema_version": {"const": "sellerkit.alibaba-localized-counter-expectation.v1"},
    "expectation_id": {"$ref": "#/$defs/nonEmpty"},
    "run_id": {"$ref": "#/$defs/nonEmpty"},
    "target_model": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\\\/\\r\\n]+$"},
    "template_product_id": {"type": "string", "pattern": "^[0-9]+$"},
    "browser_session_sha256": {"$ref": "#/$defs/sha256"},
    "page_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "field_identities_sha256": {"$ref": "#/$defs/sha256"},
    "exact_locale_set_required": {"const": true},
    "write_authority": {"const": "NONE_READ_ONLY_EVIDENCE"},
    "final_write_enabled": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "[^\\s]"},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
    "field": {
      "type": "object", "additionalProperties": false,
      "required": [
        "locale", "language_label", "direction", "value", "value_sha256",
        "observed_count", "raw_counter_text", "maximum", "unit",
        "render_sha256", "control_sha256"
      ],
      "properties": {
        "locale": {"$ref": "#/$defs/locale"},
        "language_label": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "[^\\s]"},
        "direction": {"enum": ["LTR", "RTL"]},
        "value": {"type": "string", "maxLength": 65535},
        "value_sha256": {"$ref": "#/$defs/sha256"},
        "observed_count": {"type": "integer", "minimum": 0},
        "raw_counter_text": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "[^\\s]"},
        "maximum": {"type": "integer", "minimum": 1},
        "unit": {"enum": ["UNICODE_CODE_POINTS", "UTF8_BYTES", "PLATFORM_COUNTER"]},
        "render_sha256": {"$ref": "#/$defs/sha256"},
        "control_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
