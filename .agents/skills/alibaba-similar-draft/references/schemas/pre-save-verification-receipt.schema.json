{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/alibaba-similar-draft/pre-save-verification-receipt.schema.json",
  "title": "Alibaba Pre-save Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "status", "result_semantics", "target_model",
    "template_product_id", "run_id", "bindings", "expected_field_count",
    "expected_clear_count", "expected_asset_count", "observed_field_count",
    "observed_clear_count", "observed_asset_count", "draft_save_count",
    "final_write_count", "errors"
  ],
  "properties": {
    "schema_version": {"const": "sellerkit.alibaba.pre-save-verification.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS_PRE_SAVE_NO_WRITE", "BLOCKED_PRE_SAVE"]},
    "result_semantics": {"const": "FORM_READBACK_ONLY_NOT_DRAFT_SUCCESS_NOT_WRITE_AUTHORITY"},
    "target_model": {"type": ["string", "null"]},
    "template_product_id": {"anyOf": [{"type": "string", "pattern": "^[0-9]+$"}, {"type": "null"}]},
    "run_id": {"type": ["string", "null"]},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["action_plan_sha256", "action_plan_body_sha256", "run_spec_sha256", "probe_source_sha256", "probe_verification_sha256", "pre_save_readback_sha256", "expected_field_set_sha256", "expected_clear_set_sha256", "expected_asset_set_sha256", "expected_non_target_scope_sha256"],
      "properties": {
        "action_plan_sha256": {"type": "string"}, "action_plan_body_sha256": {"type": "string"},
        "run_spec_sha256": {"type": "string"}, "probe_source_sha256": {"type": "string"},
        "probe_verification_sha256": {"type": "string"}, "pre_save_readback_sha256": {"type": "string"},
        "expected_field_set_sha256": {"type": "string"}, "expected_clear_set_sha256": {"type": "string"},
        "expected_asset_set_sha256": {"type": "string"}, "expected_non_target_scope_sha256": {"type": "string"}
      }
    },
    "expected_field_count": {"type": "integer", "minimum": 0}, "expected_clear_count": {"type": "integer", "minimum": 0},
    "expected_asset_count": {"type": "integer", "minimum": 0}, "observed_field_count": {"type": "integer", "minimum": 0},
    "observed_clear_count": {"type": "integer", "minimum": 0}, "observed_asset_count": {"type": "integer", "minimum": 0},
    "draft_save_count": {"type": ["integer", "null"], "minimum": 0}, "final_write_count": {"type": ["integer", "null"], "minimum": 0},
    "errors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "PASS_PRE_SAVE_NO_WRITE"}}, "required": ["status"]},
    "then": {"properties": {
      "target_model": {"type": "string", "minLength": 1}, "template_product_id": {"type": "string", "pattern": "^[0-9]+$"},
      "run_id": {"type": "string", "minLength": 1}, "draft_save_count": {"const": 0}, "final_write_count": {"const": 0},
      "errors": {"maxItems": 0},
      "bindings": {"properties": {
        "action_plan_sha256": {"$ref": "#/$defs/sha256"}, "action_plan_body_sha256": {"$ref": "#/$defs/sha256"},
        "run_spec_sha256": {"$ref": "#/$defs/sha256"}, "probe_source_sha256": {"$ref": "#/$defs/sha256"},
        "probe_verification_sha256": {"$ref": "#/$defs/sha256"}, "pre_save_readback_sha256": {"$ref": "#/$defs/sha256"},
        "expected_field_set_sha256": {"$ref": "#/$defs/sha256"}, "expected_clear_set_sha256": {"$ref": "#/$defs/sha256"},
        "expected_asset_set_sha256": {"$ref": "#/$defs/sha256"}, "expected_non_target_scope_sha256": {"$ref": "#/$defs/sha256"}
      }}
    }},
    "else": {"properties": {"errors": {"minItems": 1}}}
  }],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
