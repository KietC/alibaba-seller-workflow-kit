{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/platform_product_snapshot.schema.json",
  "title": "Alibaba historical platform product snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "product_id",
    "historical_observation_only",
    "approved_fact",
    "catalog_observation",
    "public_page",
    "source_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "pattern": "^[0-9]+$"},
    "historical_observation_only": {"const": true},
    "approved_fact": {"const": false},
    "catalog_observation": {"type": "object"},
    "public_page": {"type": "object"},
    "asset_count": {"type": "integer", "minimum": 0},
    "source_artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
