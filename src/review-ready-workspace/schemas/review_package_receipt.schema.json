{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/review_package_receipt.schema.json",
  "title": "V2 local review package receipt",
  "type": "object",
  "required": ["schema_version", "status", "build_status", "local_review_status", "remote_write_status", "release_status", "package_id", "package_collection", "package_digest", "package_digest_definition", "model", "generated_from_frozen_source_at", "engine_version", "files", "source_hashes", "invariants", "review_state", "receipt_authentication"],
  "properties": {
    "schema_version": {"const": "sellerkit.review_package_receipt.v2"},
    "status": {"const": "PASS_LOCAL_REVIEW_PACKAGE_READY_NO_REMOTE_WRITE"},
    "build_status": {"const": "PASS_LOCAL_REVIEW_PACKAGE_READY_NO_REMOTE_WRITE"},
    "local_review_status": {"const": "READY_FOR_LOCAL_HUMAN_REVIEW"},
    "remote_write_status": {"const": "DISABLED_NOT_REQUESTED"},
    "release_status": {"const": "NOT_RELEASED_V1_LOCAL_ONLY"},
    "package_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_collection": {"enum": ["ad_hoc", "priority"]},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_digest_definition": {"const": "SHA256(stable_json({files,receipt_core}))"},
    "model": {"type": "string", "minLength": 1},
    "generated_from_frozen_source_at": {"type": "string", "minLength": 1},
    "engine_version": {"const": "0.4.0"},
    "files": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "source_hashes": {
      "type": "object",
      "required": ["official_html", "official_payload", "website_archive", "website_dist_tree", "website_assets", "alibaba_catalog", "alibaba_snapshot_tree", "disposition_overlay", "database", "database_receipt", "plugin_source_tree"],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "invariants": {
      "type": "object",
      "required": ["external_write_enabled", "browser_actions", "remote_drafts", "publish_requests", "unusable_waste_records_in_suggestions", "all_commercial_suggestions_require_human_confirmation"],
      "properties": {
        "external_write_enabled": {"const": false},
        "browser_actions": {"const": 0},
        "remote_drafts": {"const": 0},
        "publish_requests": {"const": 0},
        "unusable_waste_records_in_suggestions": {"const": 0},
        "all_commercial_suggestions_require_human_confirmation": {"const": true}
      },
      "additionalProperties": false
    },
    "review_state": {"$ref": "review_state.schema.json"},
    "receipt_authentication": {"const": "UNSIGNED_LOCAL_INTEGRITY_ONLY_NOT_RELEASE_AUTHORIZATION"}
  },
  "additionalProperties": false
}
