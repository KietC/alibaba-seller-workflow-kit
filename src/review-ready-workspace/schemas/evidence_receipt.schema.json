{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerkit.local/schemas/evidence_receipt.schema.json",
  "title": "V2 local evidence receipt",
  "type": "object",
  "required": ["schema_version", "status", "build_status", "local_review_status", "remote_write_status", "release_status", "engine_version", "created_at_utc", "files", "file_count", "evidence_digest", "plugin_source_tree_sha256", "database_sha256", "database_receipt_sha256", "source_report", "external_write_enabled", "browser_actions", "remote_drafts", "publish_requests"],
  "properties": {
    "schema_version": {"const": "sellerkit.evidence_receipt.v2"},
    "status": {"const": "PASS_LOCAL_EVIDENCE_RECEIPT_BUILT_NO_REMOTE_WRITE"},
    "build_status": {"const": "PASS_LOCAL_EVIDENCE_RECEIPT_BUILT_NO_REMOTE_WRITE"},
    "local_review_status": {"const": "READY_FOR_LOCAL_HUMAN_REVIEW"},
    "remote_write_status": {"const": "DISABLED_NOT_REQUESTED"},
    "release_status": {"const": "NOT_RELEASED_V1_LOCAL_ONLY"},
    "engine_version": {"const": "0.4.0"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "file_count": {"type": "integer", "minimum": 1},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plugin_source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "database_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_report": {"type": "object"},
    "external_write_enabled": {"const": false},
    "browser_actions": {"const": 0},
    "remote_drafts": {"const": 0},
    "publish_requests": {"const": 0}
  },
  "additionalProperties": false
}
