{
  "$comment": "Release identity is compared exactly to the approved local configuration by the runtime; this schema has no seller-specific identity. / 发布标识由运行时与获批配置精确比对，本结构不含卖家专属身份。",
  "$id": "https://sellerkit.local/schemas/official_current_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "assets": {
      "type": "array"
    },
    "attributes": {
      "type": "array"
    },
    "canonical_model": {
      "pattern": "^[A-Z0-9]+$",
      "type": "string"
    },
    "raw_model": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "sellerkit.website_product.v1"
    },
    "source": {
      "additionalProperties": true,
      "properties": {
        "approval_status": {
          "const": "needs_review"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "release_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_disposition": {
          "const": "OFFICIAL_CURRENT_REVIEW_REQUIRED"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_type": {
          "const": "official_current"
        }
      },
      "required": [
        "source_type",
        "source_sha256",
        "payload_sha256",
        "release_id",
        "source_disposition",
        "approval_status"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "canonical_model",
    "raw_model",
    "attributes",
    "assets",
    "source"
  ],
  "title": "Official current product derivative",
  "type": "object"
}
